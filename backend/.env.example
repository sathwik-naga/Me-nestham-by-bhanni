# Server Configuration
PORT=5000
NODE_ENV=development

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds

# Supabase
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Shiprocket Logistics
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in
SHIPROCKET_TOKEN_EXPIRY_BUFFER=300

# Resend Email Integration
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Me Nestham <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
LOW_STOCK_THRESHOLD=5
EMAIL_ENABLED=true

# OTP Module Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@menesthambybhanni.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Me Nestham By Bhanni <noreply@menesthambybhanni.com>"

